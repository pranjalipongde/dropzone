generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// Using enums instead of raw strings means the
// database rejects any invalid value at write time
// ─────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING     // order created, payment not yet confirmed
  PAID        // Stripe confirmed payment
  PROCESSING  // admin acknowledged, preparing to ship
  SHIPPED     // dispatched
  DELIVERED   // confirmed delivered
  CANCELLED
}

// ─────────────────────────────────────────────
// USER
// passwordHash is nullable — Google OAuth users
// never set a password, so this stays null for them
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String?
  role         Role     @default(CUSTOMER)
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders        Order[]
  reviews       Review[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  @@map("users")
}

// ─────────────────────────────────────────────
// CATEGORY
// ─────────────────────────────────────────────

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  image    String?
  products Product[]

  @@map("categories")
}

// ─────────────────────────────────────────────
// PRODUCT
// images is Json — stores an array of Cloudinary
// URLs e.g. ["https://res.cloudinary.com/..."]
// isFeatured controls the homepage featured drops
// ─────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  images      Json
  isFeatured  Boolean  @default(false)
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category      Category       @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  reviews       Review[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  @@index([categoryId])
  @@index([slug])
  @@map("products")
}

// ─────────────────────────────────────────────
// ORDER
// address is Json — stores shipping address as
// { line1, city, state, postalCode, country }
// We store the whole address at order time so it
// doesn't break if the user changes their address later
// ─────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  userId          String
  status          OrderStatus @default(PENDING)
  total           Decimal     @db.Decimal(10, 2)
  stripePaymentId String?
  address         Json
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  orderItems OrderItem[]

  @@index([userId])
  @@map("orders")
}

// ─────────────────────────────────────────────
// ORDER ITEM
// price stores the price AT TIME OF PURCHASE —
// not a reference to product.price which can change
// Cascade: deleting an order deletes its items too
// ─────────────────────────────────────────────

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─────────────────────────────────────────────
// REVIEW
// @@unique([userId, productId]) enforces one review
// per user per product at the database level
// ─────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

// ─────────────────────────────────────────────
// CART ITEM
// @@unique([userId, productId]) means adding the
// same product twice just updates quantity instead
// of creating a duplicate row
// ─────────────────────────────────────────────

model CartItem {
  id        String @id @default(cuid())
  userId    String
  productId String
  quantity  Int    @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("cart_items")
}

// ─────────────────────────────────────────────
// WISHLIST ITEM
// Same pattern as CartItem but no quantity —
// you either saved a product or you didn't
// ─────────────────────────────────────────────

model WishlistItem {
  id        String @id @default(cuid())
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}